# ─────────────────────────────────────────────────────────────────────────────
# PhishGuard — Environment Configuration Template
# Copy this file to .env and fill in your actual credentials/keys.
# ─────────────────────────────────────────────────────────────────────────────

# Flask Configuration
FLASK_SECRET_KEY=phishguard-dev-secret-key-change-in-production
PORT=5000
DEBUG=True

# Google Gemini API Key (Required for Multilingual translation & AI Chatbot)
# Get a key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# External Threat Intelligence APIs (Optional)
# VirusTotal API Key: https://www.virustotal.com/
VIRUSTOTAL_API_KEY=
# Google Safe Browsing API Key: https://developers.google.com/safe-browsing
GOOGLE_SAFE_BROWSING_KEY=

